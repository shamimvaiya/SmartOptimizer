<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpDX" Version="4.2.0" ExcludeAssets="compile" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" ExcludeAssets="compile" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" ExcludeAssets="compile" />
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SharpDX">
      <HintPath>$(NuGetPackageRoot)sharpdx\4.2.0\lib\net40\SharpDX.dll</HintPath>
    </Reference>
    <Reference Include="SharpDX.Direct3D11">
      <HintPath>$(NuGetPackageRoot)sharpdx.direct3d11\4.2.0\lib\net40\SharpDX.Direct3D11.dll</HintPath>
    </Reference>
    <Reference Include="SharpDX.DXGI">
      <HintPath>$(NuGetPackageRoot)sharpdx.dxgi\4.2.0\lib\net40\SharpDX.DXGI.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>

<Window x:Class="SmartOptimizer.UI.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIM/OPT Stealth Overlay"
        Height="115"
        Width="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <!-- Hardware-Accelerated Breathing Glow Animation -->
        <Storyboard x:Key="BreathingGlowPulse">
            <DoubleAnimation Storyboard.TargetName="StatusShadow"
                             Storyboard.TargetProperty="BlurRadius"
                             From="4"
                             To="18"
                             Duration="0:0:1.4"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="StatusShadow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3"
                             To="1.0"
                             Duration="0:0:1.4"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource BreathingGlowPulse}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="MainBorder"
            Background="#E60F0F14"
            CornerRadius="12"
            BorderBrush="#39FF14"
            BorderThickness="1.5"
            MouseDown="MainBorder_MouseDown"
            Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect Color="#39FF14"
                              BlurRadius="20"
                              ShadowDepth="0"
                              Opacity="0.35"/>
        </Border.Effect>
        <Grid Margin="14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Breathing Dot -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot"
                             Width="10"
                             Height="10"
                             Fill="#39FF14"
                             Margin="0,0,8,0">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="StatusShadow"
                                              Color="#39FF14"
                                              BlurRadius="8"
                                              ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="AIM/OPT"
                               Foreground="White"
                               FontWeight="Black"
                               FontSize="13"/>
                    <TextBlock Text=" STEALTH"
                               Foreground="#39FF14"
                               FontWeight="Bold"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="✕"
                        Click="CloseOverlay_Click"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Foreground="#666"
                        BorderThickness="0"
                        FontSize="11"
                        Cursor="Hand"/>
            </Grid>

            <!-- Status Body -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        Margin="18,3,0,3">
                <TextBlock x:Name="TxtStatus"
                           Text="Engine Ready"
                           Foreground="#CCD6F6"
                           FontSize="11"
                           FontWeight="Medium"/>
                <TextBlock x:Name="TxtPreset"
                           Text="Preset: FreeFire_Opt"
                           Foreground="#39FF14"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Hotkey Badge Footer -->
            <Border Grid.Row="2"
                    Background="#16161D"
                    CornerRadius="5"
                    Padding="8,2"
                    HorizontalAlignment="Center"
                    BorderBrush="#252530"
                    BorderThickness="1">
                <TextBlock x:Name="TxtHotkeyHint"
                           Text="[HOME] Toggle HUD"
                           Foreground="#8892B0"
                           FontSize="9"
                           FontWeight="Bold"/>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="SmartOptimizer.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartOptimizer.UI.Components"
        xmlns:vm="clr-namespace:SmartOptimizer.UI.ViewModels"
        Title="AIM/OPT - Emulator Performance Optimizer"
        Height="790"
        Width="1260"
        MinHeight="700"
        MinWidth="1120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border Background="#0C0C10"
            CornerRadius="14"
            BorderBrush="#252733"
            BorderThickness="1.5"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="35"
                              ShadowDepth="10"
                              Opacity="0.8"/>
        </Border.Effect>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0"
                    Background="#111116"
                    BorderBrush="#1F202B"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- App Brand Header -->
                    <StackPanel Grid.Row="0" Margin="22,25,22,25">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="AIM"
                                       Foreground="#39FF14"
                                       FontSize="30"
                                       FontWeight="Black">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#39FF14"
                                                      BlurRadius="15"
                                                      ShadowDepth="0"
                                                      Opacity="0.6"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="/OPT"
                                       Foreground="White"
                                       FontSize="30"
                                       FontWeight="Black"/>
                        </StackPanel>
                        
                        <Border Background="#162B16"
                                CornerRadius="10"
                                Padding="8,3"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                BorderBrush="#39FF14"
                                BorderThickness="1">
                            <TextBlock Text="PRO OPTIMIZER v2.1"
                                       Foreground="#39FF14"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Navigation Menu -->
                    <StackPanel Grid.Row="1" Margin="14,10,14,10">
                        <Button x:Name="BtnDashboard"
                                Click="NavButton_Click"
                                Tag="Dashboard"
                                Height="48"
                                Margin="0,4"
                                Background="#1A2A1A"
                                BorderBrush="#39FF14"
                                BorderThickness="1"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Margin="15,0">
                                <TextBlock Text="⚡" FontSize="16" Foreground="#39FF14" Margin="0,0,12,0"/>
                                <TextBlock Text="Dashboard"
                                           FontSize="14"
                                           Foreground="#39FF14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnPerformance"
                                Click="NavButton_Click"
                                Tag="Performance"
                                Height="48"
                                Margin="0,4"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Margin="15,0">
                                <TextBlock Text="🚀" FontSize="16" Foreground="#8892B0" Margin="0,0,12,0"/>
                                <TextBlock Text="Performance"
                                           FontSize="14"
                                           Foreground="#A0AEC0"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnMacro"
                                Click="NavButton_Click"
                                Tag="Macro"
                                Height="48"
                                Margin="0,4"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Margin="15,0">
                                <TextBlock Text="🎨" FontSize="16" Foreground="#8892B0" Margin="0,0,12,0"/>
                                <TextBlock Text="Visual Macro"
                                           FontSize="14"
                                           Foreground="#A0AEC0"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSettings"
                                Click="NavButton_Click"
                                Tag="Settings"
                                Height="48"
                                Margin="0,4"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Margin="15,0">
                                <TextBlock Text="⚙" FontSize="16" Foreground="#8892B0" Margin="0,0,12,0"/>
                                <TextBlock Text="Settings &amp; Overlay"
                                           FontSize="14"
                                           Foreground="#A0AEC0"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Footer: System Telemetry & Exit -->
                    <StackPanel Grid.Row="2" Margin="16,0,16,18">
                        <Border Background="#16161D"
                                CornerRadius="10"
                                Padding="12,10"
                                Margin="0,0,0,12"
                                BorderBrush="#252733"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CPU LOAD" Foreground="#667085" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CpuPercentage, StringFormat={}{0}%}" Foreground="#00E5FF" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="RAM USAGE" Foreground="#667085" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding RamUsageMb, StringFormat={}{0} MB}" Foreground="#39FF14" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Click="Exit_Click"
                                Height="42"
                                Background="#241416"
                                BorderBrush="#FF4444"
                                BorderThickness="1"
                                Cursor="Hand">
                            <TextBlock Text="✕  EXIT SOFTWARE"
                                       Foreground="#FF4444"
                                       FontWeight="Bold"
                                       FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN WORKSPACE -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP BAR (Draggable Window Header + Title + Presets + Window Controls) -->
                <Border Grid.Row="0"
                        Background="#101015"
                        BorderBrush="#1F202B"
                        BorderThickness="0,0,0,1"
                        Padding="24,12"
                        MouseDown="TopBar_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Page Title -->
                        <TextBlock Text="{Binding PageTitle}"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <!-- Preset Switcher -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,20,0">
                            <TextBlock Text="Active Preset:"
                                       Foreground="#8892B0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding AvailablePresets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      SelectionChanged="PresetComboBox_SelectionChanged"
                                      Width="170"
                                      Height="34"
                                      Background="#16161E"
                                      Foreground="#39FF14"
                                      BorderBrush="#2D2D3B"
                                      Padding="6,2"/>
                            <Button Content="+ New Preset"
                                    Click="CreatePreset_Click"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    Padding="12,0"
                                    Background="#1A2A1A"
                                    Foreground="#39FF14"
                                    BorderBrush="#39FF14"
                                    BorderThickness="1.5"
                                    FontWeight="Bold"
                                    Cursor="Hand"/>
                        </StackPanel>

                        <!-- Window Buttons (Minimize, Maximize, Close) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🗕"
                                    Click="Minimize_Click"
                                    Width="32"
                                    Height="32"
                                    Background="Transparent"
                                    Foreground="#8892B0"
                                    BorderThickness="0"
                                    FontSize="12"
                                    Cursor="Hand"/>
                            <Button Content="🗖"
                                    Click="Maximize_Click"
                                    Width="32"
                                    Height="32"
                                    Background="Transparent"
                                    Foreground="#8892B0"
                                    BorderThickness="0"
                                    FontSize="12"
                                    Cursor="Hand"/>
                            <Button Content="✕"
                                    Click="Exit_Click"
                                    Width="32"
                                    Height="32"
                                    Background="Transparent"
                                    Foreground="#FF5555"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PAGE CONTENT CONTAINER -->
                <Grid Grid.Row="1" Margin="24">

                    <!-- ==================================================== -->
                    <!-- PAGE 1: DASHBOARD -->
                    <!-- ==================================================== -->
                    <Grid x:Name="Page_Dashboard" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Status Telemetry Cards -->
                        <UniformGrid Grid.Row="0" Columns="3" Height="115" Margin="0,0,0,20">
                            <!-- Emulator Status Card -->
                            <Border Background="#15151B"
                                    CornerRadius="12"
                                    Margin="0,0,10,0"
                                    BorderBrush="#252733"
                                    BorderThickness="1">
                                <StackPanel Margin="18,14">
                                    <TextBlock Text="EMULATOR STATUS" Foreground="#667085" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding EmulatorStatusText}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FF4444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEmulatorDetected}" Value="True">
                                                        <Setter Property="Foreground" Value="#39FF14"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Automatic Process Hook" Foreground="#555E70" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- ADB Status Card with Editable Port Box -->
                            <Border Background="#15151B"
                                    CornerRadius="12"
                                    Margin="5,0,5,0"
                                    BorderBrush="#252733"
                                    BorderThickness="1">
                                <Grid Margin="18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ADB CONNECTION" Foreground="#667085" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding AdbStatusText}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF4444"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdbConnected}" Value="True">
                                                            <Setter Property="Foreground" Value="#00E5FF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Auto Local ADB Discovery" Foreground="#555E70" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Editable ADB Port Override -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                                        <TextBlock Text="PORT:" Foreground="#8892B0" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBox Text="{Binding AdbPort, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="65"
                                                 Height="28"
                                                 Background="#181822"
                                                 Foreground="#00E5FF"
                                                 BorderBrush="#2D2D38"
                                                 FontSize="12"
                                                 FontWeight="Bold"
                                                 HorizontalContentAlignment="Center"
                                                 Margin="0,3,0,0"
                                                 ToolTip="Custom ADB Port (default: 5555)"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Engine Status Card -->
                            <Border Background="#15151B"
                                    CornerRadius="12"
                                    Margin="10,0,0,0"
                                    BorderBrush="#252733"
                                    BorderThickness="1">
                                <StackPanel Margin="18,14">
                                    <TextBlock Text="OPTIMIZER ENGINE" Foreground="#667085" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding EngineStatusText}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFB300"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEngineActive}" Value="True">
                                                        <Setter Property="Foreground" Value="#39FF14"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Real-time Core Thread" Foreground="#555E70" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Installed Emulators & Action Controller -->
                        <Border Grid.Row="1"
                                Background="#141419"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,20"
                                BorderBrush="#252733"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="INSTALLED &amp; CUSTOM EMULATORS"
                                           Foreground="#8892B0"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding InstalledEmulators}"
                                              SelectedItem="{Binding SelectedInstalledEmulator}"
                                              DisplayMemberPath="Name"
                                              Height="40"
                                              Background="#181822"
                                              Foreground="#39FF14"
                                              BorderBrush="#2D2D38"
                                              FontWeight="Bold"/>
                                    
                                    <!-- Add Emulator Button via File Dialog -->
                                    <Button Grid.Column="1"
                                            Content="+ Add Emulator"
                                            Click="AddEmulator_Click"
                                            Height="40"
                                            Margin="10,0,0,0"
                                            Padding="14,0"
                                            Background="#181822"
                                            Foreground="#00E5FF"
                                            BorderBrush="#00E5FF"
                                            BorderThickness="1.5"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            ToolTip="Add custom emulator .exe via file browser"/>

                                    <Button Grid.Column="2"
                                            Content="▶ LAUNCH &amp; HOOK"
                                            Command="{Binding LaunchEmulatorCommand}"
                                            Height="40"
                                            Margin="10,0,0,0"
                                            Padding="18,0"
                                            Background="#1A2A1A"
                                            Foreground="#39FF14"
                                            BorderBrush="#39FF14"
                                            BorderThickness="1.5"
                                            FontWeight="Bold"
                                            Cursor="Hand"/>

                                    <Button Grid.Column="3"
                                            Content="🔄 Rescan"
                                            Click="RescanEmulators_Click"
                                            Height="40"
                                            Margin="10,0,0,0"
                                            Padding="14,0"
                                            Background="#181822"
                                            Foreground="#CCD6F6"
                                            BorderBrush="#2D2D38"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Command="{Binding InitializeSystemCommand}"
                                            Height="46"
                                            Padding="22,0"
                                            Background="#162B16"
                                            BorderBrush="#39FF14"
                                            BorderThickness="2"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ " FontSize="15" Foreground="#39FF14"/>
                                            <TextBlock Text="INITIALIZE &amp; OPTIMIZE SYSTEM"
                                                       Foreground="#39FF14"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding OptimizeMemoryCommand}"
                                            Height="46"
                                            Margin="14,0,0,0"
                                            Padding="18,0"
                                            Background="#1A1E29"
                                            BorderBrush="#00E5FF"
                                            BorderThickness="1.5"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🧹 " FontSize="14" Foreground="#00E5FF"/>
                                            <TextBlock Text="FLUSH RAM CACHE"
                                                       Foreground="#00E5FF"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Live Neon Terminal Log -->
                        <Border Grid.Row="2"
                                Background="#0E0E12"
                                CornerRadius="12"
                                Padding="16"
                                BorderBrush="#20222B"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#39FF14" Margin="0,0,8,0"/>
                                        <TextBlock Text="LIVE ENGINE TERMINAL LOG"
                                                   Foreground="#8892B0"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                    <Button Content="Clear Log"
                                            Click="ClearLogs_Click"
                                            HorizontalAlignment="Right"
                                            Background="Transparent"
                                            Foreground="#667085"
                                            BorderThickness="0"
                                            FontSize="10"
                                            Cursor="Hand"/>
                                </Grid>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Logs}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#8892B0"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ==================================================== -->
                    <!-- PAGE 2: PERFORMANCE TWEAKS -->
                    <!-- ==================================================== -->
                    <Grid x:Name="Page_Performance" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">

                                <!-- Process Priority Card -->
                                <Border Background="#141419"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,15"
                                        BorderBrush="#252733"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Process Priority Injection" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Elevates emulator process scheduler priority in Windows for minimal input latency."
                                                       Foreground="#8892B0" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailablePriorities}"
                                                  SelectedItem="{Binding SelectedPriority}"
                                                  Width="180"
                                                  Height="36"
                                                  Background="#181822"
                                                  Foreground="#39FF14"
                                                  BorderBrush="#2D2D38"
                                                  FontWeight="Bold"/>
                                    </Grid>
                                </Border>

                                <!-- CPU Affinity Core Locker -->
                                <Border Background="#141419"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,15"
                                        BorderBrush="#252733"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="CPU Core Affinity Matrix" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="Locks emulator threads onto high-performance physical CPU cores to eliminate stutter."
                                                           Foreground="#8892B0" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding EnableCpuAffinity}"
                                                      Content="Enable Affinity Lock"
                                                      Foreground="#39FF14"
                                                      FontWeight="Bold"
                                                      VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Core Pickers Grid -->
                                        <ItemsControl ItemsSource="{Binding CpuCores}" Margin="0,15,0,15">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1A1A22"
                                                            CornerRadius="6"
                                                            Padding="10,6"
                                                            Margin="0,0,10,10"
                                                            BorderBrush="#2D2D38"
                                                            BorderThickness="1">
                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  Content="{Binding DisplayName}"
                                                                  Foreground="#CCD6F6"
                                                                  FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🚀 All Performance Cores"
                                                    Command="{Binding SelectAllPerformanceCoresCommand}"
                                                    Padding="12,6"
                                                    Background="#1A2A1A"
                                                    Foreground="#39FF14"
                                                    BorderBrush="#39FF14"
                                                    BorderThickness="1"
                                                    FontWeight="Bold"
                                                    Cursor="Hand"/>
                                            <Button Content="Select All Cores"
                                                    Command="{Binding SelectAllCoresCommand}"
                                                    Margin="10,0,0,0"
                                                    Padding="12,6"
                                                    Background="#181822"
                                                    Foreground="#CCD6F6"
                                                    BorderBrush="#2D2D38"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ADB FPS Un-locker & Display DPI -->
                                <Border Background="#141419"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,15"
                                        BorderBrush="#252733"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                                            <TextBlock Text="ADB FPS Target Booster" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Overclock emulator rendering pipeline via Android debug sysprops (60 - 144 FPS)."
                                                       Foreground="#8892B0" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,20">
                                            <TextBlock Text="{Binding TargetFps, StringFormat={}{0} FPS Target}"
                                                       Foreground="#39FF14"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,4"/>
                                            <Slider Minimum="60"
                                                    Maximum="144"
                                                    Value="{Binding TargetFps}"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBlock Text="Android DPI Density Scaling" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Fine-tune resolution scaling and pixel density (wm density)."
                                                       Foreground="#8892B0" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayDpi, StringFormat={}{0} DPI}"
                                                       Foreground="#00E5FF"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,4"/>
                                            <Slider Minimum="160"
                                                    Maximum="480"
                                                    Value="{Binding DisplayDpi}"
                                                    TickFrequency="10"
                                                    IsSnapToTickEnabled="True"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Apply All Button -->
                                <Button Command="{Binding ApplyPerformanceTweaksCommand}"
                                        Height="48"
                                        Background="#162B16"
                                        BorderBrush="#39FF14"
                                        BorderThickness="2"
                                        Cursor="Hand">
                                    <TextBlock Text="💾  APPLY &amp; SAVE TWEAKS TO PROFILE"
                                               Foreground="#39FF14"
                                               FontSize="14"
                                               FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================================================== -->
                    <!-- PAGE 3: VISUAL MACRO STUDIO -->
                    <!-- ==================================================== -->
                    <Grid x:Name="Page_Macro" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Macro Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="▶ RUN MACRO"
                                        Click="RunMacro_Click"
                                        Height="36"
                                        Padding="18,0"
                                        Background="#162B16"
                                        Foreground="#39FF14"
                                        BorderBrush="#39FF14"
                                        BorderThickness="1.5"
                                        FontWeight="Bold"
                                        Cursor="Hand"/>
                                <Button Content="⏹ STOP"
                                        Click="StopMacro_Click"
                                        Height="36"
                                        Margin="10,0,0,0"
                                        Padding="18,0"
                                        Background="#2A1616"
                                        Foreground="#FF4444"
                                        BorderBrush="#FF4444"
                                        BorderThickness="1"
                                        FontWeight="Bold"
                                        Cursor="Hand"/>
                                <Button Content="🗑 Clear Canvas"
                                        Click="ClearMacroBoard_Click"
                                        Height="36"
                                        Margin="10,0,0,0"
                                        Padding="14,0"
                                        Background="#181822"
                                        Foreground="#A0AEC0"
                                        BorderBrush="#2D2D38"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="💾 Save Graph"
                                        Click="SaveGraph_Click"
                                        Height="36"
                                        Padding="14,0"
                                        Background="#1A1E29"
                                        Foreground="#00E5FF"
                                        BorderBrush="#00E5FF"
                                        BorderThickness="1"
                                        FontWeight="Bold"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <!-- Interactive Node Canvas Component -->
                        <Border Grid.Row="1"
                                Background="#0B0B0E"
                                BorderBrush="#252733"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                ClipToBounds="True">
                            <local:NodeCanvas x:Name="NodeCanvasControl"/>
                        </Border>
                    </Grid>

                    <!-- ==================================================== -->
                    <!-- PAGE 4: SETTINGS & OVERLAY -->
                    <!-- ==================================================== -->
                    <Grid x:Name="Page_Settings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">

                                <!-- Interactive Hotkey Recorder Card -->
                                <Border Background="#141419"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,15"
                                        BorderBrush="#252733"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Interactive Stealth Overlay Hotkey" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Click the box below and press any key to record your preferred HUD toggle shortcut."
                                                       Foreground="#8892B0" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Hotkey Capture Input Box -->
                                        <TextBox x:Name="TxtHotkeyRecorder"
                                                 Grid.Column="1"
                                                 Text="{Binding OverlayHotkey, Mode=TwoWay}"
                                                 PreviewKeyDown="TxtHotkeyRecorder_PreviewKeyDown"
                                                 GotFocus="TxtHotkeyRecorder_GotFocus"
                                                 LostFocus="TxtHotkeyRecorder_LostFocus"
                                                 IsReadOnly="True"
                                                 Width="150"
                                                 Height="38"
                                                 Background="#181822"
                                                 Foreground="#39FF14"
                                                 BorderBrush="#39FF14"
                                                 BorderThickness="1.5"
                                                 FontWeight="Bold"
                                                 FontSize="13"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Cursor="Hand"
                                                 ToolTip="Click here and press any key (HOME, INSERT, F8, etc.)"/>

                                        <Button Grid.Column="2"
                                                Content="💾 Save Hotkey"
                                                Click="SaveHotkey_Click"
                                                Height="38"
                                                Margin="10,0,0,0"
                                                Padding="14,0"
                                                Background="#162B16"
                                                Foreground="#39FF14"
                                                BorderBrush="#39FF14"
                                                BorderThickness="1"
                                                FontWeight="Bold"
                                                Cursor="Hand"/>
                                    </Grid>
                                </Border>

                                <!-- Overlay Auto-Hide Card -->
                                <Border Background="#141419"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,15"
                                        BorderBrush="#252733"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Smart Auto-Hide HUD" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Automatically hides the HUD after 4 seconds; stays visible on mouse hover."
                                                       Foreground="#8892B0" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="OverlayAutoHideCheckBox"
                                                  Grid.Column="1"
                                                  IsChecked="{Binding OverlayAutoHide}"
                                                  Checked="OverlayAutoHideCheckBox_Changed"
                                                  Unchecked="OverlayAutoHideCheckBox_Changed"
                                                  Content="Active"
                                                  Foreground="#39FF14"
                                                  FontWeight="Bold"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Target Process Override Card -->
                                <Border Background="#141419"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,15"
                                        BorderBrush="#252733"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Target Emulator Process Override" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="Process targeted by scheduler hooks (e.g. HD-Player.exe, dnplayer.exe, Nox.exe)."
                                                   Foreground="#8892B0" FontSize="12" Margin="0,4,0,10"/>
                                        <TextBox Text="{Binding TargetProcessOverride}"
                                                 Background="#181822"
                                                 Foreground="#39FF14"
                                                 BorderBrush="#2D2D38"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 Padding="10,8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Preset Management Hub -->
                                <Border Background="#141419"
                                        CornerRadius="12"
                                        Padding="20"
                                        BorderBrush="#252733"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Preset Management &amp; Profiles" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="Create, duplicate, or delete custom optimization configuration profiles."
                                                   Foreground="#8892B0" FontSize="12" Margin="0,4,0,15"/>
                                        
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+ Create Profile"
                                                    Click="CreatePreset_Click"
                                                    Height="36"
                                                    Padding="14,0"
                                                    Background="#1A2A1A"
                                                    Foreground="#39FF14"
                                                    BorderBrush="#39FF14"
                                                    BorderThickness="1"
                                                    FontWeight="Bold"
                                                    Cursor="Hand"/>
                                            <Button Content="📋 Duplicate Active"
                                                    Click="DuplicatePreset_Click"
                                                    Height="36"
                                                    Margin="10,0,0,0"
                                                    Padding="14,0"
                                                    Background="#1A1E29"
                                                    Foreground="#00E5FF"
                                                    BorderBrush="#00E5FF"
                                                    BorderThickness="1"
                                                    FontWeight="Bold"
                                                    Cursor="Hand"/>
                                            <Button Content="🗑 Delete Active"
                                                    Click="DeletePreset_Click"
                                                    Height="36"
                                                    Margin="10,0,0,0"
                                                    Padding="14,0"
                                                    Background="#2A1616"
                                                    Foreground="#FF4444"
                                                    BorderBrush="#FF4444"
                                                    BorderThickness="1"
                                                    FontWeight="Bold"
                                                    Cursor="Hand"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
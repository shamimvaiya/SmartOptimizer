<UserControl x:Class="SmartOptimizer.UI.Components.NodeCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0C0C0F"
             ClipToBounds="True">
    <Grid>
        <!-- Canvas Viewport with Grid Dots/Lines -->
        <Border x:Name="BoardContainer"
                Background="#0D0D11"
                MouseDown="Board_MouseDown"
                MouseMove="Board_MouseMove"
                MouseUp="Board_MouseUp"
                MouseWheel="Board_MouseWheel">
            <Canvas x:Name="BoardCanvas"
                    Width="6000"
                    Height="4000"
                    Background="Transparent">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CanvasScale"
                                        ScaleX="1"
                                        ScaleY="1"/>
                        <TranslateTransform x:Name="CanvasTranslate"
                                            X="0"
                                            Y="0"/>
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Wire Layer for Bézier Curves -->
                <Canvas x:Name="WireCanvas"
                        Width="6000"
                        Height="4000"
                        IsHitTestVisible="False"/>

                <!-- Node Layer -->
                <Canvas x:Name="MainCanvas"
                        Width="6000"
                        Height="4000"
                        Background="Transparent">
                    <!-- Helper Overlay Hint -->
                    <Border Background="#20000000"
                            CornerRadius="8"
                            Padding="12,6"
                            Canvas.Left="30"
                            Canvas.Top="20"
                            BorderBrush="#1F2430"
                            BorderThickness="1"
                            IsHitTestVisible="False">
                        <TextBlock Text="⚡ Right-Click to Add Node | Middle-Drag to Pan | Ctrl+Wheel to Zoom"
                                   Foreground="#667085"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Canvas>
            </Canvas>
        </Border>

        <!-- Slide-out Neon Glass Inspector Panel -->
        <Border x:Name="EditPanel"
                Width="320"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0,15,15,15"
                Padding="20"
                Background="#E6121217"
                BorderBrush="#39FF14"
                BorderThickness="1.5"
                CornerRadius="12"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#39FF14"
                                  BlurRadius="25"
                                  ShadowDepth="0"
                                  Opacity="0.35"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#39FF14" Margin="0,0,8,0"/>
                        <TextBlock Text="NODE INSPECTOR"
                                   Foreground="#39FF14"
                                   FontSize="15"
                                   FontWeight="Black"/>
                    </StackPanel>
                    <Button Content="✕"
                            Click="ClosePanel_Click"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Foreground="#FF5555"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Padding="6,0"/>
                </Grid>

                <!-- Body / Parameter Fields -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-5,0">
                    <StackPanel Margin="0,0,5,0">
                        <TextBlock Text="Action Type"
                                   Foreground="#8892B0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="ComboActionType"
                                  Margin="0,0,0,15"
                                  Height="36"
                                  Background="#16161D"
                                  Foreground="White"
                                  BorderBrush="#2D2D38"
                                  SelectionChanged="ComboActionType_SelectionChanged">
                            <ComboBoxItem Content="Search Color"/>
                            <ComboBoxItem Content="Move Mouse"/>
                            <ComboBoxItem Content="Click Mouse"/>
                            <ComboBoxItem Content="Press Key"/>
                            <ComboBoxItem Content="Delay"/>
                            <ComboBoxItem Content="ADB Tap"/>
                            <ComboBoxItem Content="ADB Shell"/>
                        </ComboBox>

                        <TextBlock Text="Parameters &amp; Configuration"
                                   Foreground="#8892B0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtParamHelp"
                                   Text="Format: X, Y, Width, Height, #HexColor"
                                   Foreground="#555E70"
                                   FontSize="10"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtParameters"
                                 Height="90"
                                 Background="#16161D"
                                 Foreground="#39FF14"
                                 BorderBrush="#2D2D38"
                                 Padding="10"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 TextChanged="TxtParameters_TextChanged"/>

                        <!-- Preset Action Helpers -->
                        <TextBlock Text="Quick Templates"
                                   Foreground="#8892B0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,15,0,8"/>
                        <WrapPanel>
                            <Button Content="Center Screen 200x200"
                                    Click="TemplateCenter_Click"
                                    Margin="0,0,6,6"
                                    Padding="8,4"
                                    Background="#1A1E29"
                                    Foreground="#00E5FF"
                                    BorderBrush="#00E5FF"
                                    BorderThickness="1"
                                    FontSize="10"
                                    Cursor="Hand"/>
                            <Button Content="Left Click"
                                    Click="TemplateLeftClick_Click"
                                    Margin="0,0,6,6"
                                    Padding="8,4"
                                    Background="#1A1E29"
                                    Foreground="#00E5FF"
                                    BorderBrush="#00E5FF"
                                    BorderThickness="1"
                                    FontSize="10"
                                    Cursor="Hand"/>
                            <Button Content="Delay 50ms"
                                    Click="TemplateDelay_Click"
                                    Margin="0,0,6,6"
                                    Padding="8,4"
                                    Background="#1A1E29"
                                    Foreground="#00E5FF"
                                    BorderBrush="#00E5FF"
                                    BorderThickness="1"
                                    FontSize="10"
                                    Cursor="Hand"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer / Action Buttons -->
                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="APPLY &amp; SAVE"
                            Click="ClosePanel_Click"
                            Height="38"
                            Background="#162B16"
                            Foreground="#39FF14"
                            BorderBrush="#39FF14"
                            BorderThickness="1.5"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                    <Button Grid.Column="1"
                            Content="🗑 DELETE"
                            Click="DeleteActiveNode_Click"
                            Height="38"
                            Margin="8,0,0,0"
                            Padding="12,0"
                            Background="#2A1616"
                            Foreground="#FF4444"
                            BorderBrush="#FF4444"
                            BorderThickness="1"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<Application x:Class="SmartOptimizer.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="DarkBackground" Color="#0C0C10"/>
        <SolidColorBrush x:Key="CardBackground" Color="#14141A"/>
        <SolidColorBrush x:Key="InputBackground" Color="#16161E"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#282936"/>
        <SolidColorBrush x:Key="NeonGreen" Color="#39FF14"/>
        <SolidColorBrush x:Key="CyanAccent" Color="#00E5FF"/>
        <SolidColorBrush x:Key="LightText" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="MutedText" Color="#8892B0"/>

        <!-- High-Contrast ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#16161E"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#20222E">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1F2A1F"/>
                                <Setter Property="Foreground" Value="#39FF14"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#183618"/>
                                <Setter Property="Foreground" Value="#39FF14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High-Contrast ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#16161E"/>
            <Setter Property="Foreground" Value="#39FF14"/>
            <Setter Property="BorderBrush" Value="#2D2D3B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- High-Contrast TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#16161E"/>
            <Setter Property="Foreground" Value="#39FF14"/>
            <Setter Property="BorderBrush" Value="#2D2D3B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="#39FF14"/>
            <Setter Property="SelectionBrush" Value="#1F3A1F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Application.Resources>
</Application>
